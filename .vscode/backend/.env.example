# ============================================
# CONFIGURACIÓN DEL BACKEND ACIPS
# ============================================
# Copia este archivo como .env y completa con tus credenciales

# --- APLICACIÓN ---
APP_NAME=ACIPS API
FLASK_ENV=development
FLASK_DEBUG=True
APP_VERSION=1.0.0
PORT=5000

# --- FIREBASE ---
# Obtén estas credenciales en: https://console.firebase.google.com
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_KEY_PATH=./firebase-key.json

# --- GROQ AI ---
# Obtén tu API key gratis en: https://console.groq.com
GROQ_API_KEY=tu_groq_api_key_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# --- RUTAS DE ARCHIVOS ---
PROGRAMAS_JSON_PATH=./data/programas.json
GENERATED_FILES_PATH=./generated

# --- OCR (Reconocimiento de texto) ---
PADDLEOCR_LANGUAGE=latin
OCR_TIMEOUT_SECONDS=20
